-- ===== PILIH SEKALIGUS: cari semua objek bernama sama =====
local function sizeSig(o)
	local v = getSize(o)
	local t = {v.X, v.Y, v.Z}
	table.sort(t)
	return t
end
local function sameSize(a, b)
	for i = 1, 3 do
		if math.abs(a[i] - b[i]) > math.max(.05, b[i] * .05) then return false end
	end
	return true
end
local function inCharacter(o)
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character and o:IsDescendantOf(pl.Character) then return true end
	end
	return false
end
local function addSimilar(ref)
	local root = (scopeMode == 2 and ref.Parent) or workspace
	local generic = (ref.Name == ref.ClassName) or ref.Name == "Part" or ref.Name == "Model"
	local needSize = (critMode == 2) or generic
	local refSig = needSize and sizeSig(ref) or nil
	local found, matched = {}, {}
	for _, d in ipairs(root:GetDescendants()) do
		if d ~= newObj and d.Name == ref.Name and d.ClassName == ref.ClassName
			and (d:IsA("Model") or d:IsA("BasePart")) and not (newObj and d:IsDescendantOf(newObj)) then
			local nested, a = false, d.Parent
			while a and a ~= root do
				if matched[a] then nested = true; break end
				a = a.Parent
			end
			if not nested and not inCharacter(d) and (not needSize or sameSize(sizeSig(d), refSig)) then
				matched[d] = true
				table.insert(found, d)
			end
		end
	end
	if #found > 500 then
		toast("Terlalu banyak (" .. #found .. "). Ganti LINGKUP/KRITERIA di tab OPSI", C.BAD)
		return
	end
	local noBox = #found > 60
	oldSource = (#oldList == 0) and ("⚡ " .. ref.Name) or "⚡ campuran"
	local added = 0
	for _, d in ipairs(found) do
		if not oldSet[d] then addOld(d, noBox); added = added + 1 end
	end
	local msg = "⚡ " .. added .. " objek '" .. ref.Name .. "' ditambahkan"
	if generic then msg = msg .. " (cocok ukuran)" end
	if noBox then msg = msg .. " • outline off" end
	toast(msg, added > 0 and C.OK or C.WARN)
end

local function overUI()
	if not Main.Visible then return false end
	local p = UIS:GetMouseLocation()
	local a, s = Main.AbsolutePosition, Main.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

table.insert(conns, Mouse.Button1Down:Connect(function()
	if not pickMode or overUI() then return end
	local t = Mouse.Target
	if not t then toast("Tidak ada objek di situ", C.BAD); return end
	local obj = t
	if tapMode == 1 and obj.Parent and obj.Parent:IsA("Model") then obj = obj.Parent end
	if pickMode == "new" then
		setNew(obj); setPick(nil)
	elseif pickMode == "old" then
		if #oldList == 0 then oldSource = "✋ manual" elseif oldSource ~= "✋ manual" then oldSource = "campuran" end
		if oldSet[obj] then removeOld(obj); refreshInfo() else addOld(obj) end
	elseif pickMode == "name" then
		addSimilar(obj)
	elseif pickMode == "folder" then
		local parent = obj.Parent
		clearOld()
		oldSource = "📂 " .. ((parent and parent ~= workspace) and parent.Name or obj.Name)
		local n = 0
		if parent and parent ~= workspace then
			for _, ch in ipairs(parent:GetChildren()) do
				if (ch:IsA("Model") or ch:IsA("BasePart")) and ch ~= newObj then addOld(ch); n = n + 1 end
			end
		else
			addOld(obj); n = 1
		end
		toast(n .. " objek ditambahkan", C.OK)
